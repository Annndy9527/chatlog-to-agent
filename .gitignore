# Public files are explicitly allowed below. Everything else stays local.
# The audited third_party/WeChatMsg snapshot is intentionally tracked with git add -f.
# New files inside that directory stay ignored until individually reviewed.
/*
!/.gitignore
!/README.md
!/ATTRIBUTION.md
!/UPSTREAM_SOURCE.json

!/docs/
/docs/*
!/docs/RUNBOOK.md
!/docs/PRIVACY.md

!/prompts/
/prompts/*
!/prompts/create-assistant.md
!/prompts/assistant-system.md
!/prompts/topic-bootstrap.md
!/prompts/handoff.md

!/examples/
/examples/*
!/examples/synthetic-dialogue.md

!/scripts/
/scripts/*
!/scripts/check_public.py
